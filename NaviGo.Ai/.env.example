# ==============================================================================
# NaviGo Environment Configuration
# Copy this file to .env for local development. In production (Replit / Render),
# configure these variables in the platform's Secrets manager.
# ==============================================================================

# Server Environment & Networking
APP_ENV=dev                                       # [Required] 'dev' for local, 'prod' for cloud
PORT=8000                                         # [Required] Server port, default 8000
HOST=0.0.0.0                                      # [Required] Bind host, 0.0.0.0 for containers/Replit
PUBLIC_BASE_URL=http://localhost:8000             # [Required] Public canonical URL for share links
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000 # [Required] Comma-separated CORS origins

# Supabase (Database, Auth, Storage, Realtime)
# Get from: https://supabase.com/dashboard/project/<your-project>/settings/api
SUPABASE_URL=                                     # [Optional for Demo Mode] e.g. https://xyz.supabase.co
SUPABASE_ANON_KEY=                                # [Optional for Demo Mode] Safe for frontend client
SUPABASE_SERVICE_ROLE_KEY=                        # [Optional for Demo Mode] Backend admin operations only

# AI Models & Providers
# Gemini API Key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=                                   # [Optional for Demo Mode] Google AI Studio Key
GEMINI_MODEL=gemini-3.8-flash                     # [Optional] Configurable model ID (e.g. gemini-2.0-flash, gemini-1.5-flash)

# OpenAI ChatGPT Fallback (Optional)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=                                   # [Optional] Automatic fallback if Gemini exhausts quota
OPENAI_MODEL=gpt-4o-mini                          # [Optional] ChatGPT model ID (e.g. gpt-4o-mini, gpt-4o)

# OpenRouteService Routing & Matrix (Optional)
# Get from: https://openrouteservice.org/dev/#/signup
ORS_API_KEY=                                      # [Optional] Route matrix calculation (falls back to haversine)

# Security & Background Cron
CRON_SECRET=navigo_local_cron_secret_change_me    # [Required in Prod] Bearer token for /api/internal/cron/*
ENABLE_INTERNAL_SCHEDULER=false                   # [Optional] True only for persistent VM / local dev

# Web Push Notifications (VAPID)
# Generated via: python scripts/gen_vapid.py
VAPID_PUBLIC_KEY=                                 # [Optional] Web Push VAPID public key
VAPID_PRIVATE_KEY=                                # [Optional] Web Push VAPID private key
VAPID_CLAIM_EMAIL=admin@navigo.app                # [Optional] Web Push mailto contact
